# Copy the keys you need into Hermes' own .env (%LOCALAPPDATA%\hermes\.env).
# Generate random values, e.g.: python -c "import secrets;print('brg_'+secrets.token_hex(16))"

CLINE_BRIDGE_PROXY_KEY=
OPENCODE_BRIDGE_PROXY_KEY=
ANTI_GRAVITY_BRIDGE_PROXY_KEY=

# Connector performance knobs
CONNECTOR_PROBE_CONCURRENCY=4
CONNECTOR_PROBE_TIMEOUT=150
CONNECTOR_PROBE_COOLDOWN_H=6
CONNECTOR_AUTO_REFRESH_MIN=30
CONNECTOR_WATCHDOG_SEC=60

# Combo routing
COMBO_ATTEMPT_TIMEOUT=35

# Bridge subprocess timeouts (keep below CONNECTOR_PROBE_TIMEOUT)
CLINE_BRIDGE_PROXY_TIMEOUT=90
ANTI_GRAVITY_BRIDGE_PROXY_TIMEOUT=110
